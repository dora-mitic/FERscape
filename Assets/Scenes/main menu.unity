  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Hodnik:\r\n-\tu hodniku se mogu prona\u0107i 2 papira koja se odnose na
    zagonetku s bazom podataka, na temelju ta dva papira (podsjetnik za SQL i papir
    koji odaje da je klju\u010D za izlaz iz zgrade u uredu Matije Turkovi\u0107a)
    igra\u010D zaklju\u010Duje da na monitor u hodniku treba upisati sljede\u0107i
    upit \u201EWHERE imeNastavnik=\u201CMatija\u201C AND prezimeNastavnik=\u201CTurkovi\u0107\u201C\u201C
    kako bi saznao da je ured koji tra\u017Ei u sobi D-348, odnosno na tre\u0107em
    katu\r\n-\tsada se treba u\u0107i u lift u kojem se pronalazi potrgani papir
    s nepotpunim DKA (deterministi\u010Dki kona\u010Dni automat) koji se mo\u017Ee
    nadopuniti povla\u010Denjem druge polovice papira (iz inventara) koja se nalazi
    u hodniku\r\n-\tna temelju papira i zaslona u liftu na kojem pi\u0161e \u201ESTANJE:
    1\u201C treba se zaklju\u010Diti da se to tre\u0107eg kata dolazi kada se nalazimo
    u prihvatljivom stanju 7, odnosno treba se od stanja 1 stiskati botune koji vode
    do stanja 7 (npr.  \u201E2133\u201C,ili \u201E2132\u201C) nakon \u010Dega se
    otvaraju vrata lifta i igra\u010D ulazi u ured\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
