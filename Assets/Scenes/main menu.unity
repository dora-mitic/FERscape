--- !u!114 &2049160588
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2049160586}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Knji\u017Enica:\r\n-\tna kutiji s otpornicima se nalaze informacije o
    strujnom krugu unutar kutije i formule za ra\u010Dunanje otpora (na temelju struje
    i napona), otpora serijskog i paralelnog spoja otpornika\r\n-\tna temelju formula
    se prvo ra\u010Duna ukupni otpor strujnog kruga (100/2=50), a zatim se mora zaklju\u010Diti
    da su jedina dva otpornika koja \u0107e u paralelnom spoju dati otpor od 50 oma
    otpornici od 75 i 150 oma nakon \u010Dega se u knji\u017Enici upale svjetla\r\n-\tu
    knji\u017Enici se na podu nalazi papir s novim zadatkom s dva nacrtana grafa
    i nepoznatom frekvencijom\r\n-\tiz grafova se o\u010Ditavaju vrijednosti A=6
    i v=50 koje igra\u010D na temelju znanja iz fizike treba uvrstiti u formulu f=v/2A\u03C0
    i izra\u010Dunati da je frekvencija pribli\u017Eno jednaka 1,3\r\n-\tosim papira
    u sobi igra\u010D mo\u017Ee koristiti i radio na kojemu se mo\u017Ee namjestiti
    frekvencija, na njega namje\u0161ta frekvenciju 1,3 nakon \u010Dega dobije tekstualni
    i audio zapis koji mu otkriva \u0161ifru od ladice koja je do tad bila zaklju\u010Dana
    lokotom\r\n-\tladica se otvara kodom 1196, a u njoj se nalazi USB koji igra\u010D
    mo\u017Ee staviti u ra\u010Dunalo na stolu knji\u017Enice\r\n-\tra\u010Dunalo
    zatim ispisuje HEX kod FCA, u sobi se ne mo\u017Ee koristiti vi\u0161e ni\u0161ta
    osim glavnih vrata knji\u017Enice na kojima se nalaze tri lokota s 4 broja na
    kojima se mogu staviti samo brojevi 1 i 0, sada igra\u010D zna da na tri lokota
    treba redom upisati binarni zapis heksadecimalnih znamenki F (1111), C (1100)
    i A (1010)\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
